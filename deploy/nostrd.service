# systemd unit for running nostrd on a VM (see docs/deploy/).
# Copy to /etc/systemd/system/nostrd.service, adjust the config path,
# then: sudo systemctl daemon-reload && sudo systemctl enable --now nostrd

[Unit]
Description=nostrd Nostr relay server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/nostrd --config /etc/nostrd/nostrd.toml start --foreground
Restart=always
RestartSec=5
# Harden the service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target