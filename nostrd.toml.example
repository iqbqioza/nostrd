# =============================================================================
# nostrd configuration template
#
# Copy this file to `nostrd.toml` (or pass `--config <path>` to the CLI) and
# adjust the values. Every setting is optional: missing entries fall back to
# the defaults shown here, so a minimal file with a handful of overrides is
# enough to run the relay.
#
# Commands:
#   nostrd start    start as a daemon (add --foreground to run in the shell)
#   nostrd restart  stop and start again (reloads nostrd.toml)
#   nostrd stop     stop the running daemon
#   nostrd stats    show live statistics of the running daemon
#   nostrd check    validate this file and exit
#   nostrd init     write a default configuration and exit
#
# Sending SIGHUP to the daemon reloads this file at runtime (limits and
# server settings apply immediately; the NIP-40 toggle is applied live too).
# =============================================================================

# -----------------------------------------------------------------------------
# Relay identity and metadata (advertised in the NIP-11 info document)
# -----------------------------------------------------------------------------
[relay]
# Human-readable relay name.
name = "nostrd"

# Short description of the relay.
description = "A minimal and stable Nostr relay"

# Administrative contact pubkey (32-byte hex) advertised in the info document.
pubkey = ""

# Alternative contact (URL or mailto URI).
contact = ""

# Relay icon URL.
icon = ""

# Posting policy text advertised in the info document.
post_policy = ""

# Hex-encoded secret key of the relay itself. When set, the relay can sign
# and publish NIP-29 group metadata events and NIP-43 role/membership events,
# and its pubkey is advertised as the NIP-11 `self` field.
private_key = ""

# Public URL of this relay as seen by clients (e.g. "wss://relay.example.com").
# Used for NIP-62 request-to-vanish matching and NIP-42 auth relay-tag checks;
# falls back to server.host:server.port when empty. Always set this when the
# relay sits behind a TLS-terminating proxy or Cloudflare Tunnel, where the
# public scheme is wss while the local listener is plain ws.
public_url = ""

# Optional LiveKit server URL for NIP-29 live audio/video rooms.
livekit_url = ""
livekit_api_key = ""
livekit_api_secret = ""

# Explicit NIP allowlist: when non-empty, only the listed NIPs are advertised
# and their behavior is enabled. Empty means "all except disabled_nips".
enabled_nips = []

# NIPs to disable (behavior off and not advertised). File-storage NIPs
# (34 git, 94 file metadata, 96 HTTP storage) are never implemented.
disabled_nips = []

# -----------------------------------------------------------------------------
# Network server
# -----------------------------------------------------------------------------
[server]
# Bind address of the relay's WebSocket/HTTP endpoint. The default binds
# loopback only: clients on other machines cannot connect. Use "0.0.0.0" to
# listen on every interface (direct remote access), or keep "127.0.0.1" when
# the relay is reached through a reverse proxy on the same machine (nginx,
# Caddy, cloudflared, ...).
host = "127.0.0.1"
port = 8080

# WebSocket upgrades are also accepted when a TLS-terminating proxy announces
# the client scheme via `X-Forwarded-Proto` (ws/wss/http/https are all
# accepted), so Cloudflare Tunnel and similar setups work out of the box.
# For those setups set relay.public_url to the public wss:// address.

# Separate localhost management port for the legacy NIP-86 REST endpoints;
# 0 disables the management server entirely. The NIP-86 JSON-RPC API is
# always served on the relay's own HTTP endpoint.
management_port = 0
management_host = "127.0.0.1"

# Bearer token that authorizes NIP-86 management calls
# (Authorization: Bearer <token>). Empty disables this method.
management_token = ""

# Admin pubkey that authorizes NIP-86 management calls via a NIP-98 event
# (Authorization: Nostr <base64 event>). Empty disables this method.
admin_pubkey = ""

# Require every connection to perform the NIP-42 AUTH flow before REQ and
# EVENT messages are honored.
require_auth = false

# Send the NIP-42 AUTH challenge to every new connection.
send_auth_challenge = true

# -----------------------------------------------------------------------------
# Limits (anti-abuse and resource bounds)
# -----------------------------------------------------------------------------
[limits]
# Maximum number of concurrent WebSocket connections.
max_connections = 10000

# Per-source-IP cap on WebSocket connections: a single host cannot consume
# the whole connection budget (a socket flood from one IP would otherwise
# evict legitimate clients). 0 = no per-IP cap.
max_connections_per_ip = 0

# Maximum size in bytes of a single incoming WebSocket message.
max_ws_message_size = 1048576

# Maximum number of filters in a single REQ/COUNT message.
max_filters = 20

# Maximum number of active subscriptions per connection.
max_subscriptions = 20

# Per-filter cap for the number of events returned by a REQ.
max_limit = 500

# Cap for the number of events counted by a NIP-45 COUNT (results beyond the
# cap are reported with `"approximate": true`).
count_limit = 2000

# Maximum length of a subscription id.
max_sub_id_len = 64

# Maximum number of characters (unicode) of an event's `content` field,
# matching the NIP-11 `max_content_length` semantics. The byte size is
# bounded by max_ws_message_size instead.
max_content_bytes = 65536

# Maximum number of tags on an event.
max_tags = 2000

# Maximum bytes of a single tag value.
max_tag_value_bytes = 1024

# Events whose created_at is more than this many seconds in the future are
# silently dropped with an OK `mute:` prefix instead of rejected.
max_created_at_future = 3600

# NIP-13 proof-of-work difficulty required for new events (0 disables).
require_pow = 0

# Maximum number of content words indexed for NIP-50 search per event.
max_indexed_words = 128

# Initial size in bytes of each connection's WebSocket read/write buffers
# (they grow on demand). Keep small so that many idle connections do not
# pin megabytes each.
buffer_size = 2048

# NIP-77: maximum number of records a single NEG-OPEN may process; queries
# exceeding this are rejected with a NEG-ERR carrying the cap.
neg_max_items = 100000

# Seconds a database request may wait before timing out (0 = wait forever).
# A timeout keeps the relay responsive even when the storage is stuck: the
# request fails with a clear error instead of hanging the connection.
db_request_timeout_secs = 30

# Spam defense: a pubkey's first accepted event is recorded, and events from
# pubkeys first seen less than this many seconds ago are rejected with
# `restricted: your account is too new`. 0 disables the check.
new_pubkey_min_age_secs = 0

# Maximum bytes of outgoing messages queued per connection before new ones
# are dropped (protects memory against slow readers).
max_out_queue_bytes = 262144

# Overload protection: when the database thread's queue holds more than this
# many pending messages (or db_queue_events pending events), new database
# requests fail fast instead of accumulating in memory. Keeps the relay up
# under sustained overload instead of running out of memory.
db_queue_msgs = 4096
db_queue_events = 262144

# Maximum total bytes of subscription filters held per connection.
max_sub_bytes = 524288

# NIP-29: reject group events whose created_at is older than this many
# seconds (late-publication prevention); 0 disables the check.
group_late_publish_secs = 604800

# Live fan-out batching: events are broadcast to subscribers in batches of
# at most `live_batch_size` events every `live_batch_interval_ms`
# milliseconds, so idle connections wake up once per batch.
live_batch_interval_ms = 10
live_batch_size = 64

# Bounded queue of events waiting to be broadcast live; messages are dropped
# (never stored) when it overflows, remaining available via subscriptions.
live_buffer = 65536

# REST API (`/api/v1/...`) protection. The API shares the database with the
# WebSocket server, so these bounds keep a flood of REST traffic from
# degrading (or crashing) the WebSocket subscribers.
# Maximum number of concurrent `/api/v1` queries served at once. Requests
# beyond this limit fail fast with a 503 instead of queuing up behind
# WebSocket work.
api_max_concurrent = 32

# Upper bound for the `limit` query parameter (0 = no bound). Larger values
# are clamped down to this ceiling.
api_max_limit = 500

# Upper bound for the `offset` query parameter (0 = no bound). Larger values
# are rejected with a 400.
api_max_offset = 10000

# Maximum length in bytes of the `search` query parameter (0 = no bound).
# Longer values are rejected with a 400.
api_max_search_bytes = 1024

# -----------------------------------------------------------------------------
# Database (LMDB via heed)
# -----------------------------------------------------------------------------
[database]
# Directory holding the LMDB environment.
path = "./data"

# Maximum number of named databases.
max_dbs = 32

# Maximum number of concurrent reader threads.
max_readers = 128

# Initial memory map size in bytes. The map is opened at this size and never
# resized at runtime: resizing would require that no read transactions are
# active, which cannot be guaranteed while the shared reader and the REST API
# reader threads hold concurrent read transactions. Physical memory and disk
# usage grow only with the data actually stored (sparse file).
map_size = 1073741824

# Upper bound for the memory map. This is a virtual address space reservation
# backed by a sparse file: physical memory and disk usage grow only with the
# data actually stored. The map is opened at map_max_size on startup (or at
# map_size, whichever is larger), so this setting is the real ceiling. On
# 32-bit systems it is capped at 2 GiB.
map_max_size = 1099511627776

# Interval in seconds between NIP-40 expired-event purge runs.
purge_interval_secs = 300

# Build the NIP-50 full-text word index (searches still work without it via
# a full scan, but are slower).
search_index = true

# -----------------------------------------------------------------------------
# Daemon
# -----------------------------------------------------------------------------
[daemon]
# PID file used by `nostrd start/stop/restart`.
pid_file = "./nostrd.pid"

# Log file (stdout/stderr of the daemon).
log_file = "./nostrd.log"

# File written periodically with the relay statistics (read by `nostrd stats`).
stats_file = "./nostrd.stats.json"

# Interval in seconds between statistics file writes.
stats_interval_secs = 5

# -----------------------------------------------------------------------------
# Access control (seeded from this file at startup). NIP-86 management calls
# (banpubkey, allowkind, blockip, ...) mutate these lists at runtime, but the
# runtime changes are in-memory only and are lost on restart: put persistent
# rules here.
# -----------------------------------------------------------------------------
[access]
# Pubkeys whose events are rejected ("blocked: pubkey not allowed").
blocked_pubkeys = []

# When non-empty, only these pubkeys may publish (empty = allow all).
allowed_pubkeys = []

# Event kinds rejected at publish time.
blocked_kinds = []

# When non-empty, only these event kinds may be published.
allowed_kinds = []

# IP addresses refused at the WebSocket endpoint.
blocked_ips = []
